doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1')
        meta(name='description', content='TopoStrawberry-RGBD is a synchronized greenhouse RGB-D strawberry dataset with 3,758 frames, 14,286 instances, bounding boxes, five keypoints, ripeness, occlusion, and harvestability annotations.')
        meta(name='theme-color', content='#17364d')
        meta(property='og:type', content='website')
        meta(property='og:title', content='TopoStrawberry')
        meta(property='og:description', content='TopoStrawberry-RGBD: 3,758 paired RGB-D frames, 14,286 strawberry instances, and 71,430 keypoints with ripeness, occlusion, and harvestability labels.')
        meta(property='og:url', content='https://strawberry-vision-dataset.yuhao-jin.chatgpt.site/')
        meta(property='og:image', content='https://strawberry-vision-dataset.yuhao-jin.chatgpt.site/assets/og-strawberry-dataset.jpg')
        meta(name='twitter:card', content='summary_large_image')
        title TopoStrawberry | TopoStrawberry-RGBD

        link(rel='canonical', href='https://strawberry-vision-dataset.yuhao-jin.chatgpt.site/')
        link(rel='icon', type='image/png', sizes='64x64', href='assets/strawberry-favicon.png?v=pink')
        link(rel='apple-touch-icon', href='assets/strawberry-mascot.png?v=pink')
        include includes/css.pug

    body
        a.skip-link(href='#main-content') Skip to content

        include includes/navbar.pug

        main#main-content
            header#overview.research-hero
                .container.px-4.px-lg-5
                    .project-label Controlled-access dataset | Updated October 2026

                    h1 TopoStrawberry: A Large-Scale Harvest-Oriented RGB-D Dataset with Topological Keypoint Refinement and Keypoint-Anchored Harvest-State Recognition

                    .paper-authorship(aria-label='Authors and affiliations')
                        p.paper-authors
                            span.paper-author
                                | Yuhao Jin
                                sup a,b
                            | , 
                            span.paper-author
                                | Xiaoyu Xia
                                sup b
                            | , 
                            span.paper-author
                                | Qizhong Gao
                                sup a,b
                            | , 
                            span.paper-author
                                | Lingyu Li
                                sup a,b
                            | , 
                            span.paper-author
                                | Yong Yue
                                sup b
                            | , 
                            span.paper-author
                                | Eng Gee Lim
                                sup b
                            | , 
                            span.paper-author
                                | Prudence Wong
                                sup a
                            | , 
                            span.paper-author
                                | Xiaohui Zhu
                                sup b,*
                        .paper-affiliations
                            p
                                sup a
                                |  School of Computer Science and Informatics, University of Liverpool, Liverpool, L69 3BX, UK
                            p
                                sup b
                                |  Academy of Artificial Intelligence and Advanced Technology, Xi’an Jiaotong-Liverpool University, Suzhou, 215123, China
                        p.paper-correspondence
                            | * Corresponding author: Xiaohui Zhu (
                            a(href='mailto:Xiaohui.Zhu@xjtlu.edu.cn') Xiaohui.Zhu@xjtlu.edu.cn
                            | )

                    .row.g-5.align-items-center
                        .col-lg-5
                            p.hero-abstract
                                | TopoStrawberry-RGBD contains 3,758 paired frames and 14,286 annotated strawberry instances. Each annotated strawberry includes a bounding box, five anatomical keypoints, and ripeness, occlusion, and harvestability labels in COCO keypoint format with instance attributes.

                            .d-flex.flex-wrap.gap-2.mt-3.mb-4
                                a.btn.btn-research(href='#resources') Download dataset
                                a.btn.btn-outline-research(href='#statistics') View dataset statistics

                            dl.project-metadata
                                .metadata-row
                                    dt Modalities
                                    dd RGB images and corresponding depth maps
                                .metadata-row
                                    dt Annotations
                                    dd Bounding boxes, keypoints, ripeness, occlusion, and harvestability labels in COCO keypoint JSON format
                                .metadata-row
                                    dt Research tasks
                                    dd Object detection, keypoint estimation, ripeness recognition, occlusion recognition, and harvestability recognition
                                .metadata-row
                                    dt Capture system
                                    dd Four Intel RealSense D435i cameras
                                .metadata-row
                                    dt Image resolution
                                    dd 1280 × 720 pixels
                                .metadata-row
                                    dt Dataset split
                                    dd Train 2,630 / Validation 564 / Test 564 frames (70% / 15% / 15%)

                        .col-lg-7
                            figure.research-figure.hero-figure
                                .figure-frame.figure-frame--clean
                                    img(
                                        src='assets/dataset-annotation-overview.webp',
                                        alt='Representative greenhouse RGB frame with strawberry bounding boxes, five landmark types, ripeness categories, and occlusion categories',
                                        width='1800',
                                        height='1080',
                                        fetchpriority='high'
                                    )
                                figcaption
                                    span.figure-number Figure 1.
                                    |  Real annotation overlay from train/0238; category IDs are shown exactly as stored.

            section#statistics.paper-section
                .container.px-4.px-lg-5
                    .section-heading
                        span.section-number 01
                        div
                            p.section-type Dataset statistics
                            h2 Dataset statistics and composition
                    p.section-summary
                        | A 70% / 15% / 15% train/validation/test split preserves all paired RGB-D frames. The tables below summarize instance density and label balance.
                    .dataset-stat-grid
                        article.dataset-stat
                            span.stat-kicker Frames
                            strong 3,758
                            p Synchronized RGB-D samples
                        article.dataset-stat
                            span.stat-kicker Instances
                            strong 14,286
                            p Strawberry bounding boxes
                        article.dataset-stat
                            span.stat-kicker Keypoints
                            strong 71,430
                            p Five keypoints per instance
                        article.dataset-stat
                            span.stat-kicker Storage
                            strong 5.70 GB
                            p 7,521 files in total; ZIP archive: 5.23 GB
                    h3#composition.dataset-subheading Split and label distributions
                    .composition-grid
                        .table-responsive.collection-table-wrap
                            table.collection-table
                                caption Frame counts, instance counts, and mean instance density by split
                                thead
                                    tr
                                        th(scope='col') Split
                                        th(scope='col') Frames
                                        th(scope='col') Share
                                        th(scope='col') Instances
                                        th(scope='col') Inst./frame
                                tbody
                                    tr
                                        th(scope='row') Train
                                        td 2,630
                                        td 70%
                                        td 9,898
                                        td 3.76
                                    tr
                                        th(scope='row') Validation
                                        td 564
                                        td 15%
                                        td 2,250
                                        td 3.99
                                    tr
                                        th(scope='row') Test
                                        td 564
                                        td 15%
                                        td 2,138
                                        td 3.79
                                tfoot
                                    tr
                                        th(scope='row') Total
                                        td 3,758
                                        td 100%
                                        td 14,286
                                        td 3.80
                        .label-summary
                            h3 Label distributions
                            p.label-footnote Maturity and ripeness share the same label encoding. Counts below cover all splits.


                            .label-definition-grid

                                .label-definition-item.label-definition-item--ripeness
                                    h4 Ripeness
                                    .label-row
                                        span 0
                                        span Immature
                                        span 4,957 (34.7%)
                                    .label-row
                                        span 1
                                        span Mature
                                        span 9,329 (65.3%)

                                .label-definition-item.label-definition-item--occlusion
                                    h4 Occlusion
                                    .label-row
                                        span 0
                                        span Non-occluded
                                        span 9,278 (64.9%)
                                    .label-row
                                        span 1
                                        span Occluded
                                        span 5,008 (35.1%)

                                .label-definition-item.label-definition-item--harvestability
                                    h4 Harvestability
                                    .label-row
                                        span 0
                                        span Not harvestable
                                        span 10,393 (72.8%)
                                    .label-row
                                        span 1
                                        span Harvestable
                                        span 3,893 (27.2%)

                                .label-definition-item.label-definition-item--keypoint
                                    h4 Keypoint visibility
                                    .label-row
                                        span 0
                                        span Outside image
                                        span 759 (1.1%)
                                    .label-row
                                        span 1
                                        span Occluded but inferable
                                        span 10,073 (14.1%)
                                    .label-row
                                        span 2
                                        span Visible
                                        span 60,598 (84.8%)

                    figure.research-figure.data-figure
                        .figure-frame.figure-frame--clean
                            img(src='assets/dataset-distributions.svg', alt='Charts showing train, validation, and test frame counts, per-split instance counts, and ripeness, occlusion, harvestability, and keypoint visibility distributions', width='1800', height='1250', loading='lazy')
                        figcaption
                            span.figure-number Figure 2.
                            |  Distribution overview for dataset splits, ripeness, occlusion, harvestability, and keypoint visibility.
            section#protocol.paper-section.paper-section--alt
                .container.px-4.px-lg-5
                    .section-heading
                        span.section-number 02
                        div
                            p.section-type Data specification
                            h2 Dataset organization and annotation format
                    p.section-summary RGB images and depth maps are organized by split, while train, validation, and test annotations are stored as three COCO-style JSON files under annotations/.
                    .spec-docs
                        section.spec-doc-section(aria-labelledby='directory-structure-title')
                            h3#directory-structure-title Dataset organization
                            pre.spec-doc-directory(aria-label='Dataset directory tree')
                                code.
                                    TopoStrawberry-RGBD/
                                    ├── images/
                                    │   ├── train/
                                    │   ├── val/
                                    │   └── test/
                                    ├── depth/
                                    │   ├── train/
                                    │   ├── val/
                                    │   └── test/
                                    └── annotations/
                                        ├── strawberry_keypoints_train.json
                                        ├── strawberry_keypoints_val.json
                                        └── strawberry_keypoints_test.json
                            p.spec-doc-note RGB and depth frames share matching filenames within each split.
                            p.spec-doc-note Depth maps are unsigned 16-bit PNGs (uint16), with values in millimeters (0.001 meters per unit). A value of 0 indicates invalid depth.
                        section.spec-doc-section(aria-labelledby='annotation-schema-title')
                            h3#annotation-schema-title Annotation format
                            .spec-doc-file
                                code strawberry_keypoints_{split}.json
                                span train · val · test
                            p.spec-doc-note Selected records from the training file: image 0238.png and instance 916. Metadata and category fields are abbreviated; instance values are preserved.
                            pre.spec-doc-json(tabindex='0', aria-label='Real COCO annotation example from the training split')
                                code.
                                    {
                                      "info": {
                                        "version": "1.0"
                                      },
                                      "licenses": [],
                                      "categories": [
                                        {
                                          "id": 1,
                                          "name": "strawberry",
                                          "keypoints": ["Cut", "Top", "Bottom", "Left", "Right"]
                                        }
                                      ],
                                      "images": [
                                        {
                                          "id": 238,
                                          "file_name": "0238.png",
                                          "width": 1280,
                                          "height": 720
                                        }
                                      ],
                                      "annotations": [
                                        {
                                          "id": 916,
                                          "image_id": 238,
                                          "category_id": 1,
                                          "bbox": [320.07518796992485, 369.02255639097746, 92.48120300751879, 149.62406015037584],
                                          "area": 13837.41308157611,
                                          "iscrowd": 0,
                                          "num_keypoints": 5,
                                          "keypoints": [371.203007518797, 373.5338345864662, 2, 368.94736842105266, 408.8721804511278, 2, 359.9248120300752, 514.8872180451127, 2, 323.08270676691734, 441.203007518797, 2, 408.796992481203, 444.9624060150376, 2],
                                          "segmentation": [],
                                          "maturity": 1,
                                          "ripeness": 1,
                                          "occlusion": 0,
                                          "harvestability": 1
                                        }
                                      ]
                                    }
                            p.spec-doc-note
                                code image_id
                                |  links an annotation to 
                                code images.id
                                | ; 
                                code category_id
                                |  links it to 
                                code categories.id
                                | .
                        section.spec-doc-section(aria-labelledby='instance-fields-title')
                            h3#instance-fields-title Instance annotation fields
                            .spec-doc-table-wrap(tabindex='0', role='region', aria-label='Instance annotation field descriptions')
                                table.spec-doc-table
                                    thead
                                        tr
                                            th(scope='col') Field
                                            th(scope='col') Description
                                            th(scope='col') Format
                                    tbody
                                        tr
                                            th(scope='row')
                                                code bbox
                                            td Bounding box in pixel coordinates
                                            td [x, y, width, height]
                                        tr
                                            th(scope='row')
                                                code keypoints
                                            td Five ordered keypoints: Cut, Top, Bottom, Left, Right
                                            td 5 × [x, y, visibility]
                                        tr
                                            th(scope='row')
                                                code maturity
                                            td Maturity state
                                            td binary: 0 = unripe; 1 = ripe
                                        tr
                                            th(scope='row')
                                                code ripeness
                                            td Maturity state (same encoding as maturity)
                                            td binary: 0 = unripe; 1 = ripe
                                        tr
                                            th(scope='row')
                                                code occlusion
                                            td Instance occlusion state
                                            td binary: 0 = unoccluded; 1 = occluded
                                        tr
                                            th(scope='row')
                                                code harvestability
                                            td Harvest suitability
                                            td binary: 0 = not harvestable; 1 = harvestable
                            p.spec-doc-note Keypoint visibility: 0 = outside the image; 1 = occluded but inferable; 2 = visible.
                            p.spec-doc-field-summary
                                strong COCO-compatible fields: 
                                code id, image_id, category_id, bbox, area, iscrowd, segmentation, keypoints, num_keypoints
                            p.spec-doc-field-summary
                                strong Dataset-specific fields: 
                                code maturity, ripeness, occlusion, harvestability
