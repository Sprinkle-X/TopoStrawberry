                .container.px-4.px-lg-5
                    .section-heading
                        span.section-number 05
                        div
                            p.section-type Dataset access
                            h2 Dataset access and resources
                    .resources-layout
                        .download-record
                            .resource-status
                                span.status-indicator(aria-hidden='true')
                                | Controlled access
                            h3 TopoStrawberry-RGBD dataset package
                            p Access to the dataset is available for approved non-commercial research purposes. To request access, please download and complete the application form, then submit it to the email address provided in the form. Applications will be reviewed individually.
                            a.btn.btn-research(
                                href='assets/TopoStrawberry_Dataset_Access_Application.docx'
                                download
                            ) Download Application Form
                        .resource-index
                            dl
                                .resource-row
                                    dt Dataset
                                    dd Controlled access
                                .resource-row
                                    dt Dataset license
                                    dd CC BY-NC 4.0

        include includes/footer.pug
        include includes/scripts.pug
