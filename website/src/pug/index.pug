doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1')
        meta(name='description', content=`TopoStrawberry-RGBD is a synchronized greenhouse RGB-D strawberry dataset with ${number(dataset.total_images)} frames, ${number(dataset.total_annotations)} instances, bounding boxes, five keypoints, maturity and occlusion annotations.`)
        meta(name='theme-color', content='#17364d')
        meta(property='og:type', content='website')
        meta(property='og:title', content='TopoStrawberry')
        meta(property='og:description', content=`TopoStrawberry-RGBD: ${number(dataset.total_images)} paired RGB-D frames, ${number(dataset.total_annotations)} strawberry instances, and ${number(dataset.total_annotations * dataset.keypoint_order.length)} keypoints with maturity and occlusion labels.`)
        if siteUrl
            meta(property='og:url', content=siteUrl)
            meta(property='og:image', content=siteUrl + 'assets/og-strawberry-dataset.jpg')
        meta(name='twitter:card', content='summary_large_image')
        title TopoStrawberry | TopoStrawberry-RGBD

        if siteUrl
            link(rel='canonical', href=siteUrl)
        link(rel='icon', type='image/png', sizes='64x64', href='assets/strawberry-favicon.png?v=pink')
        link(rel='apple-touch-icon', href='assets/strawberry-mascot.png?v=pink')
        include includes/css.pug

    body
        a.skip-link(href='#main-content') Skip to content

        include includes/navbar.pug

        main#main-content
            header#overview.research-hero
                .container.px-4.px-lg-5
                    .project-label October 2026

                    h1 TopoStrawberry: A Large-Scale Harvest-Oriented RGB-D Dataset with Topological Keypoint Refinement and Keypoint-Anchored Harvest-State Recognition

                    .paper-authorship(aria-label='Authors and affiliations')
                        p.paper-authors
                            span.paper-author
                                | Yuhao Jin
                                sup a,b
                            | , 
                            span.paper-author
                                | Xiaoyu Xia
                                sup b
                            | , 
                            span.paper-author
                                | Qizhong Gao
                                sup a,b
                            | , 
                            span.paper-author
                                | Lingyu Li
                                sup a,b
                            | , 
                            span.paper-author
                                | Yong Yue
                                sup b
                            | , 
                            span.paper-author
                                | Eng Gee Lim
                                sup b
                            | , 
                            span.paper-author
                                | Prudence Wong
                                sup a
                            | , 
                            span.paper-author
                                | Xiaohui Zhu
                                sup b
                        .paper-affiliations
                            p
                                sup a
                                |  School of Computer Science and Informatics, University of Liverpool, Liverpool, L69 3BX, UK
                            p
                                sup b
                                |  Academy of Artificial Intelligence and Advanced Technology, Xi’an Jiaotong-Liverpool University, Suzhou, 215123, China

                    p.hero-abstract
                        | TopoStrawberry-RGBD contains #{number(dataset.total_images)} paired frames and #{number(dataset.total_annotations)} annotated strawberry instances. Each annotated strawberry includes a bounding box, five anatomical keypoints, and maturity and occlusion labels in COCO keypoint format with instance attributes.

                    .row.g-5.align-items-start.hero-content-layout
                        .col-12.col-xl-5
                            dl.project-metadata
                                .metadata-row
                                    dt Modalities
                                    dd RGB images and corresponding depth maps
                                .metadata-row
                                    dt Annotations
                                    dd Bounding boxes, keypoints, maturity and occlusion labels in COCO keypoint JSON format
                                .metadata-row
                                    dt Research tasks
                                    dd Object detection, keypoint estimation, maturity recognition, and occlusion recognition
                                .metadata-row
                                    dt Capture system
                                    dd Four Intel RealSense D435i cameras
                                .metadata-row
                                    dt Image resolution
                                    dd 1280 × 720 pixels
                                .metadata-row
                                    dt Dataset split
                                    dd= Object.entries(dataset.splits).map(([key, split]) => ({train: 'Train', val: 'Validation', test: 'Test'})[key] + ' ' + number(split.images)).join(' / ') + ' frames (' + Object.values(dataset.splits).map(split => share(split.images, dataset.total_images)).join(' / ') + ')'

                            .hero-table-actions.mt-4
                                a.btn.btn-research(href='#resources') Request dataset access
                                a.btn.btn-outline-research(href='#statistics') View dataset statistics

                        .col-12.col-xl-7
                            figure.research-figure.hero-figure
                                .figure-frame.figure-frame--clean
                                    img(
                                        src='assets/dataset-annotation-overview.svg',
                                        alt='Representative greenhouse RGB frame with strawberry bounding boxes, five landmark types, maturity categories, and occlusion categories',
                                        width='1800',
                                        height='1080',
                                        fetchpriority='high'
                                    )
                                figcaption
                                    span.figure-number Figure 1.
                                    |  Real annotation overlay from train/0238.

            section#statistics.paper-section
                .container.px-4.px-lg-5
                    .section-heading
                        span.section-number 01
                        div
                            p.section-type Dataset statistics
                            h2 Dataset statistics and composition
                    p.section-summary
                        | A 70% / 15% / 15% train/validation/test split preserves all paired RGB-D frames. The tables below summarize instance density and label balance.
                    .dataset-stat-grid
                        article.dataset-stat
                            span.stat-kicker Frames
                            strong #{number(dataset.total_images)}
                            p Synchronized RGB-D samples
                        article.dataset-stat
                            span.stat-kicker Instances
                            strong #{number(dataset.total_annotations)}
                            p Strawberry bounding boxes
                        article.dataset-stat
                            span.stat-kicker Keypoints
                            strong #{number(dataset.total_annotations * dataset.keypoint_order.length)}
                            p Five keypoints per instance
                        article.dataset-stat
                            span.stat-kicker Storage
                            strong 5.70 GB
                            p 7,521 files in total; ZIP archive: 5.23 GB
                    h3#composition.dataset-subheading Split and label distributions
                    .composition-grid
                        .table-responsive.collection-table-wrap
                            table.collection-table
                                caption Frame counts, instance counts, and mean instance density by split
                                thead
                                    tr
                                        th(scope='col') Split
                                        th(scope='col') Frames
                                        th(scope='col') Share
                                        th(scope='col') Instances
                                        th(scope='col') Inst./frame
                                tbody
                                    each split, key in dataset.splits
                                        tr
                                            th(scope='row')= ({train: 'Train', val: 'Validation', test: 'Test'})[key]
                                            td= number(split.images)
                                            td= share(split.images, dataset.total_images)
                                            td= number(split.annotations)
                                            td= (split.annotations / split.images).toFixed(2)
                                tfoot
                                    tr
                                        th(scope='row') Total
                                        td= number(dataset.total_images)
                                        td 100%
                                        td= number(dataset.total_annotations)
                                        td= (dataset.total_annotations / dataset.total_images).toFixed(2)
                        .label-summary
                            h3 Label distributions
                            p.label-footnote Counts below cover all splits.


                            .label-definition-grid

                                .label-definition-item.label-definition-item--maturity
                                    h4 Maturity
                                    .label-row
                                        span 0
                                        span= dataset.attribute_labels.maturity['0']
                                        span= number(dataset.distributions.maturity['0']) + ' (' + (100 * dataset.distributions.maturity['0'] / (Object.values(dataset.distributions.maturity).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'
                                    .label-row
                                        span 1
                                        span= dataset.attribute_labels.maturity['1']
                                        span= number(dataset.distributions.maturity['1']) + ' (' + (100 * dataset.distributions.maturity['1'] / (Object.values(dataset.distributions.maturity).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'

                                .label-definition-item.label-definition-item--occlusion
                                    h4 Occlusion
                                    .label-row
                                        span 0
                                        span= dataset.attribute_labels.occlusion['0']
                                        span= number(dataset.distributions.occlusion['0']) + ' (' + (100 * dataset.distributions.occlusion['0'] / (Object.values(dataset.distributions.occlusion).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'
                                    .label-row
                                        span 1
                                        span= dataset.attribute_labels.occlusion['1']
                                        span= number(dataset.distributions.occlusion['1']) + ' (' + (100 * dataset.distributions.occlusion['1'] / (Object.values(dataset.distributions.occlusion).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'

                                .label-definition-item.label-definition-item--keypoint
                                    h4 Keypoint visibility
                                    .label-row
                                        span 0
                                        span Outside image
                                        span= number(dataset.distributions.keypoint_visibility['0']) + ' (' + (100 * dataset.distributions.keypoint_visibility['0'] / (Object.values(dataset.distributions.keypoint_visibility).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'
                                    .label-row
                                        span 1
                                        span Occluded but inferable
                                        span= number(dataset.distributions.keypoint_visibility['1']) + ' (' + (100 * dataset.distributions.keypoint_visibility['1'] / (Object.values(dataset.distributions.keypoint_visibility).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'
                                    .label-row
                                        span 2
                                        span Visible
                                        span= number(dataset.distributions.keypoint_visibility['2']) + ' (' + (100 * dataset.distributions.keypoint_visibility['2'] / (Object.values(dataset.distributions.keypoint_visibility).reduce((sum, value) => sum + value, 0))).toFixed(1) + '%)'

                    figure.research-figure.data-figure
                        .figure-frame.figure-frame--clean
                            img(src='assets/dataset-distributions.svg', alt='Charts showing train, validation, and test frame counts, per-split instance counts, and maturity, occlusion, and keypoint visibility distributions', width='1800', height='1250', loading='lazy')
                        figcaption
                            span.figure-number Figure 2.
                            |  Distribution overview for dataset splits, maturity, occlusion, and keypoint visibility.
            section#protocol.paper-section.paper-section--alt
                .container.px-4.px-lg-5
                    .section-heading
                        span.section-number 02
                        div
                            p.section-type Data specification
                            h2 Dataset organization and annotation format
                    p.section-summary RGB images and depth maps are organized by split, while train, validation, and test annotations are stored as three COCO-style JSON files under annotations/.
                    .spec-docs
                        section.spec-doc-section(aria-labelledby='directory-structure-title')
                            h3#directory-structure-title Dataset organization
                            .spec-organization-layout
                                pre.spec-doc-directory(aria-label='Dataset directory tree')
                                    code.
                                        TopoStrawberry-RGBD/
                                        ├── images/
                                        │   ├── train/
                                        │   ├── val/
                                        │   └── test/
                                        ├── depth/
                                        │   ├── train/
                                        │   ├── val/
                                        │   └── test/
                                        └── annotations/
                                            ├── strawberry_keypoints_train.json
                                            ├── strawberry_keypoints_val.json
                                            └── strawberry_keypoints_test.json
                                .spec-organization-notes
                                    p.spec-doc-note RGB and depth frames share matching filenames within each split.
                                    p.spec-doc-note Depth maps are #{dataset.depth_encoding.dtype} PNGs, with values in #{dataset.depth_encoding.unit}s (#{dataset.depth_encoding.meters_per_unit} meters per unit). Invalid depth values: #{dataset.depth_encoding.invalid_values.join(', ')}.
                                    p.spec-doc-note MMPose dataset type: #{dataset.mmpose_dataset_type}; default data mode: #{dataset.data_mode_default}.
                                    p.spec-doc-note RGB path: #{dataset.rgb_path_pattern}; depth path: #{dataset.depth_path_pattern}.
                        section.spec-doc-section(aria-labelledby='annotation-schema-title')
                            h3#annotation-schema-title Annotation format
                            .spec-doc-file
                                code strawberry_keypoints_{split}.json
                                span train · val · test
                            p.spec-doc-note The example below illustrates our JSON annotation format using 0238.png.
                            pre.spec-doc-json(tabindex='0', aria-label='Real COCO annotation example from the training split')
                                code= annotationExampleJSON
                            p.spec-doc-note
                                code image_id
                                |  links an annotation to 
                                code images.id
                                | ; 
                                code category_id
                                |  links it to 
                                code categories.id
                                | .
                        section.spec-doc-section(aria-labelledby='instance-fields-title')
                            h3#instance-fields-title Field reference
                            .spec-doc-table-wrap.field-reference-wrap(tabindex='0', role='region', aria-label='Field reference')
                                table.spec-doc-table.field-reference-table
                                    thead
                                        tr
                                            th(scope='col') Field
                                            th(scope='col') Format
                                    tbody
                                        tr
                                            th(scope='row')
                                                code bbox
                                            td
                                                code [top-left x, top-left y, width, height]
                                        tr
                                            th(scope='row')
                                                code keypoints
                                            td
                                                code 5 × [x, y, v]
                                        tr
                                            th(scope='row')
                                                code maturity
                                            td binary attribute
                                        tr
                                            th(scope='row')
                                                code occlusion
                                            td binary attribute
                            p.spec-doc-field-summary
                                strong COCO-compatible fields: 
                                code id, image_id, category_id, bbox, area, iscrowd, segmentation, keypoints, num_keypoints
                            p.spec-doc-field-summary
                                strong Dataset-specific fields: 
                                code maturity, occlusion
                            .field-reference-actions
                                a.annotation-protocol-link(href='annotation-protocol.html')
                                    span View annotation protocol
                                    span(aria-hidden='true') →
